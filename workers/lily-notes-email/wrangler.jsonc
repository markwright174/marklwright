{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "lily-notes-email",
  "main": "src/index.js",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ALLOWED_RECIPIENT": "lily-notes@marklwright.com"
  },
  "d1_databases": [
    {
      "binding": "STUDY_DB",
      "database_name": "marklwright-study",
      "database_id": "8e4606f0-fc17-45a3-a647-29d6de500265"
    }
  ]
}
