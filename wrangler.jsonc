{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "marklwright",
  "compatibility_date": "2026-08-06",
  "pages_build_output_dir": "dist",
  "vars": {
    "STUDY_AI_MODEL": "@cf/ibm-granite/granite-4.0-h-micro"
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "STUDY_DB",
      "database_name": "marklwright-study",
      "database_id": "8e4606f0-fc17-45a3-a647-29d6de500265"
    }
  ]
}
